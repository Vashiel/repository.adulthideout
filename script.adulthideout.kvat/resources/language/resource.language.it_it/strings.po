msgstr "Test completo di riproduzione"

msgctxt "#30003"
msgid "Select websites"
msgstr "Seleziona siti"

msgctxt "#30004"
msgid "Retest failed"
msgstr "Ripeti i test non riusciti"

msgctxt "#30005"
msgid "Previous reports"
msgstr "Rapporti precedenti"

msgctxt "#30006"
msgid "Export latest report"
msgstr "Esporta il rapporto più recente"

msgctxt "#30007"
msgid "Quick listing check all websites"
msgstr "Controllo rapido degli elenchi di tutti i siti"

msgctxt "#30020"
msgid "Total"
msgstr "Totale"

msgctxt "#30021"
