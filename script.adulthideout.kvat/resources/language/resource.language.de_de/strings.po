msgstr "Kodi-Player-Test (visuelle Wiedergabe)"

msgctxt "#30003"
msgid "Select websites"
msgstr "Websites auswählen"

msgctxt "#30004"
msgid "Retest failed"
msgstr "Fehler erneut testen"

msgctxt "#30005"
msgid "Previous reports"
msgstr "Frühere Berichte"

msgctxt "#30006"
msgid "Export latest report"
msgstr "Neuesten Bericht exportieren"

msgctxt "#30007"
msgid "Quick listing check all websites"
